# Large local SQLite caches (rebuilt on-demand via update_data.py)
pipeline/*.db
*.db
*.db-wal
*.db-shm

# Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Logs & temp
*.log
.DS_Store
Thumbs.db
*.pem
*.key

# Generated spatial caches
pipeline/*.geojson
sa_boundary.geojson
.pytest_cache/
node_modules/
test-results/
playwright-report/
# Coverage & Reports
.coverage
coverage.*
htmlcov/

# Impeccable engine binaries (fetched per platform locally)
**/skills/impeccable/scripts/bin/

