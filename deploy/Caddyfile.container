:80 {
    # Trust reverse proxy / Traefik
    trusted_proxies static private_ranges
    client_ip_headers X-Forwarded-For

    # Health check for Coolify & UptimeRobot
    handle /healthz {
        respond "OK" 200
    }

    # Same-origin Umami analytics proxy (avoids ad-blockers & third-party cookies)
    @umami path /stats/script.js /stats/api/send
    handle @umami {
        uri strip_prefix /stats
        reverse_proxy https://analytics.rahmahealth.net {
            header_up Host analytics.rahmahealth.net
            header_up -Cookie
            header_up CF-Connecting-IP {client_ip}
            header_up True-Client-IP {client_ip}
        }
    }
    handle /stats/* {
        respond "Not Found" 404
    }

    # API proxy to internal FastAPI backend container (osmwd-api)
    handle /api/* {
        reverse_proxy {$OSMWD_API_URL:http://osmwd-api:8010} {
            header_up X-Real-IP {client_ip}
        }
    }

    # Static data sets with versioned cache control
    @data_versioned {
        path /data/*
        query v=*
    }
    handle @data_versioned {
        root * /srv/osmwd
        header Cache-Control "public, max-age=31536000, immutable"
        try_files /published/current{uri} {path} =404
        file_server {
            precompressed br gzip
        }
    }
    handle /data/* {
        root * /srv/osmwd
        header Cache-Control "no-cache"
        try_files /published/current{uri} {path} =404
        file_server {
            precompressed br gzip
        }
    }

    # App shell & static assets
    handle {
        root * /srv/osmwd

        # Cache immutable vendor assets
        @cached {
            path /vendor/*
            query v=*
        }
        header @cached Cache-Control "public, max-age=31536000, immutable"

        # Cache-bust HTML entrypoint
        @html path / /index.html
        header @html Cache-Control "no-cache, no-store, must-revalidate"

        # Security Headers & Content Security Policy
        header {
            X-Content-Type-Options "nosniff"
            X-Frame-Options "SAMEORIGIN"
            Referrer-Policy "strict-origin-when-cross-origin"
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://server.arcgisonline.com https://*.basemaps.cartocdn.com https://commons.wikimedia.org https://upload.wikimedia.org; connect-src 'self' https://api.openstreetmap.org https://www.openstreetmap.org https://master.apis.dev.openstreetmap.org https://www.wikidata.org https://test.wikidata.org https://meta.wikimedia.org https://query.wikidata.org https://overpass-api.de https://overpass.kumi.systems https://lz4.overpass-api.de http://127.0.0.1:8111; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none';"
        }

        file_server {
            precompressed br gzip
        }
    }
}
